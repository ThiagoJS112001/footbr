{
  "name": "footbr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "productName": "FootBR",
  "config": { "forge": "./forge.config.cjs" },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "npm run build && esbuild desktop/backend.ts --bundle --platform=node --target=node24 --outfile=desktop/backend.cjs",
    "desktop": "npm run build:desktop && electron .",
    "installer:windows": "npm run build:desktop && electron-forge make --platform=win32 --arch=x64",
    "test": "vitest run",
    "gen-league": "node --experimental-strip-types scripts/gen-league.mjs",
    "sim-match": "node --experimental-strip-types scripts/sim-match.mjs",
    "sim-season": "node --experimental-strip-types scripts/sim-season.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.4.1",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron-squirrel-startup": "^1.0.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zustand": "^5.0.16"
  }
}
